# All optional.
# Where `npm run dev` forwards /api to (default: the public status page). Keep real values in .env.local, never here.
VITE_DEV_GATUS_TARGET=
# vex-auth, the sign-in shared by the *.vexoul.net sites (default: the production one, through createAccount()).
# Point it at a local vex-auth for dev; empty turns sign-in off.
VITE_AUTH_BASE=https://auth.example.net
